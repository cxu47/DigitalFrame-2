# Copy to .env. Relative paths resolve from the repository root.
# .env is gitignored. Do not put the OSS access key in this file.

CACHE_FOLDER=cache
SECRETS_FOLDER=secrets
OSS_CREDENTIALS_FILE=oss.env
USERS_FILE=users.yaml

# Positive whole seconds. 5 is valid. 5.0 is not.
DISPLAY_SECONDS=5
SYNC_INTERVAL=30
NETWORK_TIMEOUT=10

CACHE_MAX_WIDTH=1600
CACHE_MAX_HEIGHT=900
OTHER_IMAGE_QUALITY=85
IPHONE_JPEG_QUALITY=75

# Local default. Phase 4 binds a public HTTPS listener on the Hong Kong VM.
HOST=127.0.0.1
PORT=8000
# Set true only when the browser reaches the app over HTTPS.
COOKIE_SECURE=false

LOG_LEVEL=INFO

# Leave unset for a visit to list the bucket itself. true keeps a background list.
BACKGROUND_SYNC=false

# 64 hex characters. When set, every instance can read the same cookies.
# SESSION_KEY=
