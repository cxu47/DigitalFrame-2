# Copy to secrets/oss.env. That file is gitignored.
# The RAM user needs oss:ListObjects on the bucket and oss:GetObject on photos/*.

OSS_ACCESS_KEY_ID=replace-me
OSS_ACCESS_KEY_SECRET=replace-me
OSS_BUCKET_NAME=your-bucket-name
OSS_REGION=cn-hongkong
# Leave empty to use the public endpoint for this region.
# On an ECS instance in cn-hongkong, use the internal endpoint instead:
# OSS_ENDPOINT=https://oss-cn-hongkong-internal.aliyuncs.com
OSS_ENDPOINT=
OSS_PREFIX=photos/
# OSS_SESSION_TOKEN=replace-me
